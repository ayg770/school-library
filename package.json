{
  "name": "school-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @school-library/server",
    "dev:ui": "npm run dev -w @school-library/ui",
    "build": "npm run build:server && vite build packages/ui",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "build:server": "esbuild packages/server/src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=packages/server/dist/server.mjs --packages=external --alias:@school-library/core=./packages/core/src/index.ts",
    "build:desktop": "node packages/desktop/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "overrides": {
    "vite": "5.4.11"
  }
}
